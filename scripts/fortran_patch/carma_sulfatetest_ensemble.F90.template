!! Ensemble-driven sulfatetest — Phase 10.2 reference patch.
!!
!! This file is a *template* for the Fortran modifications the
!! orchestrator (scripts/fortran_orchestrator.py) expects. Drop it
!! alongside carma_sulfatetest.F90, add it to CMakeLists.txt, and
!! rebuild. The only physics change vs the original is that
!! (T, p, rh, H2SO4, aerosol_mu, aerosol_sigma_g) are read from a
!! scenario file instead of being hard-coded.
!!
!! Interface:
!!   ./carma_sulfatetest_ensemble <scenario_file> <output_file>
!!
!! <scenario_file>: one line, whitespace-separated, in order:
!!   T [K]   p [hPa]   rh [0-1]   h2so4 [pptv]   mu [nm]   sigma_g
!!
!! <output_file>: JSON with keys T_final, gc_h2so4_final,
!!   pc_final (38-element array), nstep_ran, status.
!!
!! Everything below is skeleton — see the original sulfatetest for
!! the full physics setup; just substitute the hard-coded constants
!! with the values read from the scenario file.

program carma_sulfatetest_ensemble
  use carma_precision_mod
  use carma_constants_mod
  implicit none

  ! ... (same type declarations as carma_sulfatetest.F90) ...

  character(len=512)        :: scenario_path
  character(len=512)        :: output_path
  real(kind=f)              :: T_scen, p_scen, rh_scen
  real(kind=f)              :: h2so4_pptv, mu_nm, sigma_g
  integer                   :: unit, ios

  ! --- Read CLI args ---
  if (command_argument_count() < 2) then
    write(*, '(A)') 'usage: carma_sulfatetest_ensemble <scenario> <output>'
    stop 2
  end if
  call get_command_argument(1, scenario_path)
  call get_command_argument(2, output_path)

  ! --- Read scenario ---
  open(newunit=unit, file=trim(scenario_path), action='read', iostat=ios)
  if (ios /= 0) then
    write(*, '(A, A)') 'cannot open scenario file: ', trim(scenario_path)
    stop 3
  end if
  read(unit, *, iostat=ios) T_scen, p_scen, rh_scen, &
                            h2so4_pptv, mu_nm, sigma_g
  close(unit)
  if (ios /= 0) then
    write(*, '(A)') 'malformed scenario file'
    stop 4
  end if

  ! --- Run the same physics as carma_sulfatetest, substituting:
  !       t(iz)     = T_scen
  !       p(iz)     = p_scen * 100.0_f   ! hPa → Pa
  !       relhum(iz)= rh_scen
  !       initial H2SO4 gc from h2so4_pptv + p + T
  !       initial aerosol lognormal from mu_nm / sigma_g
  !   and at the end dump T, gc(1,I_H2SO4), pc(1,:,1) + nstep, "ok"
  !   to output_path as JSON.

  ! ... (same setup, loop, and finalization as carma_sulfatetest.F90,
  !      with the substitutions above) ...

  ! --- Write JSON output ---
  open(newunit=unit, file=trim(output_path), action='write', iostat=ios)
  if (ios /= 0) then
    write(*, '(A, A)') 'cannot write output: ', trim(output_path)
    stop 5
  end if
  write(unit, '(A)') '{'
  write(unit, '(A, ES16.8, A)') '  "T_final": ', t_final, ','
  write(unit, '(A, ES16.8, A)') '  "gc_h2so4_final": ', gc_final, ','
  write(unit, '(A)', advance='no') '  "pc_final": ['
  do ibin = 1, NBIN
    if (ibin > 1) write(unit, '(A)', advance='no') ', '
    write(unit, '(ES16.8)', advance='no') pc_final(ibin)
  end do
  write(unit, '(A)') '],'
  write(unit, '(A, I0, A)') '  "nstep_ran": ', nstep, ','
  write(unit, '(A)') '  "status": "ok"'
  write(unit, '(A)') '}'
  close(unit)

end program carma_sulfatetest_ensemble
